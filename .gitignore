# ============================================================
# MessMetric - Python / FastAPI .gitignore
# ============================================================

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# -------------------------
# Python Packaging
# -------------------------
*.egg
*.egg-info/
dist/
build/
develop-eggs/
.eggs/
pip-wheel-metadata/
share/python-wheels/

# -------------------------
# Testing
# -------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# -------------------------
# Type Checking
# -------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# -------------------------
# Ruff / Linters
# -------------------------
.ruff_cache/

# -------------------------
# FastAPI / Uvicorn
# -------------------------
*.log
logs/

# -------------------------
# Alembic
# -------------------------
# Keep migration files tracked!
# Do NOT ignore the alembic/versions/ directory.

# -------------------------
# IDE - VS Code
# -------------------------
.vscode/
*.code-workspace

# -------------------------
# IDE - PyCharm / IntelliJ
# -------------------------
.idea/
*.iml
*.iws
*.ipr

# -------------------------
# Jupyter Notebook
# -------------------------
.ipynb_checkpoints/

# -------------------------
# OS Files
# -------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -------------------------
# Temporary Files
# -------------------------
*.tmp
*.temp
*.swp
*.swo
*~